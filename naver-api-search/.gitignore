# 환경 변수 및 시크릿 (API 키 유출 방지)
.env
.env.local
.env.*.local
.streamlit/secrets.toml

# 공유용 환경 변수 예시는 커밋 허용
!.env.example

# 가상환경
.venv/
venv/
env/
ENV/

# Python 바이트코드 및 캐시
__pycache__/
*.py[cod]
*$py.class

# 테스트 및 정적 분석 도구 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Streamlit 로컬 설정 및 캐시
.streamlit/

# 운영체제 및 편집기 임시 파일
.DS_Store
~$*
